# Content-addressed transport parts preserve exact original bytes, even when a
# fragment happens to contain UTF-8 text. Do not convert line endings or merge
# fragments independently of their verified inventories.
examples/production-pilot/source-bundle/parts/*.bin binary
examples/production-pilot/audio-source-bundle/parts/*.bin binary
examples/production-pilot/reviews-source-bundle/parts/*.bin binary
examples/production-pilot/evidence-source-bundle/parts/*.bin binary
examples/production-pilot/project-source-bundle/parts/*.bin binary
examples/production-pilot/media/*.mp4 binary
examples/production-pilot/media/*.png binary
examples/production-pilot/media/*.ora binary
# Index, provenance and historical evidence hashes bind encoded bytes too.
examples/production-pilot/**/*.json -text
examples/production-pilot/**/*.txt -text
examples/production-pilot/evidence/** -text
# Validation records carry exact byte digests, including on CRLF checkouts.
tests/results/*.json -text
tests/results/*.log -text
# The physics audit retains nested logs whose SHA-256 binds their exact bytes.
tests/results/physics-baseline-20261022/** -text
scripts/*.py text eol=lf
profiles/*.json text eol=lf
# Rig evidence and offline dependency inventories bind the exact encoded bytes.
examples/rig-3d/** -text linguist-generated
assets/rig-viewer/** -text
assets/rig-viewer/vendor/** linguist-vendored
rig-templates/*.json text eol=lf

# Scene3D example manifests hash the exact original JSON and mesh bytes.
examples/scene3d-contracts/** -text
# Shared JSON decoder evidence and its source-bound test retain exact bytes.
tests/results/shared-json-decoder-20261024/** -text
tests/test_rig_contracts.py text eol=lf

# Shared provenance policy: immutable examples and validation receipts retain
# authoritative Git bytes; source-bound test programs use LF on every platform.
tests/results/** -text
tests/*.py text eol=lf
examples/** -text

# Existing frozen playback/catalog compatibility contracts are byte-bound too.
assets/playback.js text eol=lf
state-library/catalog.json text eol=lf
