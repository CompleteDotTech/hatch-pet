    {
      "id": "stream-conversation",
      "name": "Streaming conversation",
      "description": "Local browser events alternate listening and speech. The one-shot interruption event restores the interrupted prior loop after completion; resume-speech is also an explicit legal manual return to speaking.",
      "states": [
        "idle",
        "listening",
        "speaking",
        "interrupted",
        "celebrating"
      ],
      "initial": "idle",
      "cancel_state": "idle",
      "steps": [
        "idle",
        "listening",
        "speaking",
        "interrupted",
        "speaking",
        "celebrating",
        "idle"
      ],
      "completion": {
        "celebrating": "idle"
      },
      "events": {
        "listen": {
          "target": "listening",
          "from": [
            "idle",
            "speaking"
          ],
          "priority": 30,
          "interrupt": "always",
          "restart": false
        },
        "speak": {
          "target": "speaking",
          "from": [
            "listening",
            "idle"
          ],
          "priority": 30,
          "interrupt": "always",
          "restart": false
        },
        "interrupt": {
          "target": "interrupted",
          "from": [
            "speaking",
            "listening"
          ],
          "priority": 80,
          "interrupt": "higher",
          "restart": false,
          "resume": true
        },
        "resume-speech": {
          "target": "speaking",
          "from": [
            "interrupted"
          ],
          "priority": 30,
          "interrupt": "always",
          "restart": false
        },
        "celebrate": {
          "target": "celebrating",
          "from": [
            "speaking",
            "listening",
            "idle"
          ],
          "priority": 50,
          "interrupt": "higher",
          "restart": false
        },
        "stream-cancel": {
          "target": "idle",
