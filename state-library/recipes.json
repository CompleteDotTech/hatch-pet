        "task-success": {
          "target": "successful",
          "from": [
            "review"
          ],
          "priority": 50,
          "interrupt": "higher",
          "restart": false
        },
        "task-ready": {
          "target": "ready",
          "from": [
            "idle"
          ],
          "priority": 10,
          "interrupt": "always",
          "restart": false
