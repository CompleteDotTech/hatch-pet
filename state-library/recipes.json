    {
      "id": "agent-success",
      "name": "Agent task success",
      "description": "Host events keep work active until review and success are known. Completion animations then return to idle without claiming actual task execution.",
      "states": [
        "ready",
        "running",
        "review",
        "successful",
        "idle"
      ],
      "initial": "ready",
      "cancel_state": "idle",
      "steps": [
