    {
      "id": "curiosity-discovery",
      "name": "Curiosity to discovery",
      "description": "A finite drawn performance from curiosity through investigation and realization to celebration; returns to idle.",
      "states": [
        "idle",
        "curious",
        "investigating",
        "realization",
        "excited",
        "celebrating"
      ],
      "initial": "idle",
      "cancel_state": "idle",
