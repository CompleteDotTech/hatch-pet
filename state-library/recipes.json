        "running",
        "review",
        "successful",
        "idle"
      ],
      "completion": {
        "successful": "idle"
      },
      "events": {
        "task-start": {
          "target": "running",
          "from": [
            "ready",
            "idle"
          ],
          "priority": 30,
          "interrupt": "higher",
          "restart": false
        },
        "task-review": {
          "target": "review",
          "from": [
            "running"
          ],
          "priority": 40,
          "interrupt": "higher",
          "restart": false
