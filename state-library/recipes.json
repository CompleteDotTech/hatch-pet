        "idle",
        "curious",
        "investigating",
        "realization",
        "excited",
        "celebrating",
        "idle"
      ],
      "completion": {
        "curious": "investigating",
        "investigating": "realization",
        "realization": "excited",
        "excited": "celebrating",
        "celebrating": "idle"
      },
      "events": {
        "discover": {
          "target": "curious",
          "from": [
            "idle"
          ],
          "priority": 40,
          "interrupt": "higher",
          "restart": false
        },
        "curiosity-discovery:cancel": {
          "target": "idle",
          "from": [
            "idle",
            "curious",
            "investigating",
            "realization",
            "excited",
            "celebrating"
          ],
          "priority": 100,
          "interrupt": "always",
          "restart": false
        }
      },
      "queue_limit": 8
    },
