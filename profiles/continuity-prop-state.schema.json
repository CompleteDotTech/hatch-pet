{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gethatch.pet/schemas/continuity-prop-state-v1",
  "title": "Continuity prop-state v1.0.0",
  "$defs": {
    "prop-state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "continuity-prop-state"
        },
        "state": {
          "$ref": "#/$defs/state-base"
        },
        "asset": {
          "$ref": "#/$defs/ref"
        },
        "owner_entity_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_socket_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "physical_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "state",
        "asset",
        "owner_entity_id",
        "owner_socket_id",
        "physical_state"
      ]
    },
    "state-base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "query": {
          "$ref": "#/$defs/query"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "source_evaluation": {
          "$ref": "#/$defs/ref"
        },
        "unavailable_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        }
      },
      "required": [
        "entity_id",
        "query",
        "transform",
        "source_evaluation",
        "unavailable_fields"
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_revision": {
          "$ref": "#/$defs/ref"
        },
        "world_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "timeline_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "branch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "story_time": {
          "$ref": "#/$defs/rational"
        },
        "presentation_time": {
          "$ref": "#/$defs/rational"
        },
        "boundary": {
          "enum": [
            "before",
            "after",
            "terminal"
          ]
        }
      },
      "required": [
        "project_revision",
        "world_id",
        "timeline_id",
        "branch_id",
        "story_time",
        "presentation_time",
        "boundary"
      ]
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!.*[\\\\:<>\\\"|?*\\x00-\\x1f])(?:(?![.]{1,2}(?:/|(?![\\s\\S])))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|/|(?![\\s\\S])))(?![^/]*[. ](?:/|(?![\\s\\S])))[^/]+/)*(?![.]{1,2}(?:/|(?![\\s\\S])))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|/|(?![\\s\\S])))(?![^/]*[. ](?:/|(?![\\s\\S])))[^/]+(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "kind"
      ]
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "translation": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/quaternion"
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000.0
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "translation",
        "rotation",
        "scale"
      ]
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1000000000000.0,
        "maximum": 1000000000000.0
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "$ref": "#/$defs/prop-state"
}
