{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gethatch.pet/schemas/continuity-animation-state-v1",
  "title": "Continuity animation-state v1.0.0",
  "$defs": {
    "animation-state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "continuity-animation-state"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "query": {
          "$ref": "#/$defs/query"
        },
        "animation": {
          "$ref": "#/$defs/ref"
        },
        "pose": {
          "$ref": "#/$defs/ref"
        },
        "phase": {
          "$ref": "#/$defs/rational"
        },
        "root_transform": {
          "$ref": "#/$defs/transform"
        },
        "velocity": {
          "$ref": "#/$defs/vec3"
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 0,
          "maxItems": 4096
        }
      },
      "required": [
        "schema_version",
        "kind",
        "entity_id",
        "query",
        "animation",
        "pose",
        "phase",
        "root_transform",
        "velocity",
        "contacts"
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_revision": {
          "$ref": "#/$defs/ref"
        },
        "world_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "timeline_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "branch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "story_time": {
          "$ref": "#/$defs/rational"
        },
        "presentation_time": {
          "$ref": "#/$defs/rational"
        },
        "boundary": {
          "enum": [
            "before",
            "after",
            "terminal"
          ]
        }
      },
      "required": [
        "project_revision",
        "world_id",
        "timeline_id",
        "branch_id",
        "story_time",
        "presentation_time",
        "boundary"
      ]
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!.*[\\\\:<>\\\"|?*\\x00-\\x1f])(?:(?! )(?![.]{1,2}(?:/|(?![\\s\\S])))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³]|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$)(?:[.]|/|(?![\\s\\S])))(?![^/]*[. ](?:/|(?![\\s\\S])))[^/]+/)*(?! )(?![.]{1,2}(?:/|(?![\\s\\S])))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³]|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$)(?:[.]|/|(?![\\s\\S])))(?![^/]*[. ](?:/|(?![\\s\\S])))[^/]+(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "kind"
      ]
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "translation": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/quaternion"
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000.0
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "translation",
        "rotation",
        "scale"
      ]
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1000000000000.0,
        "maximum": 1000000000000.0
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "$ref": "#/$defs/animation-state"
}
