{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gethatch.pet/schemas/physics-3d-job-v1",
  "title": "PhysicsJob v1",
  "description": "Structural bounds; runtime additionally validates graph, geometry, time and aggregate budgets. No solver capability is implied.",
  "$defs": {
    "PhysicsJob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "hatch-3d-physics-job"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "world": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!(?:[cC][oO][nN](?:[iI][nN]\\$|[oO][uU][tT]\\$)?|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|/|(?![\\s\\S])))[^/\\\\:\\x00-\\x1f\\x7f<>\"|?*]*[^/\\\\:\\x00-\\x1f\\x7f<>\"|?* .](?:/(?!(?:[cC][oO][nN](?:[iI][nN]\\$|[oO][uU][tT]\\$)?|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|/|(?![\\s\\S])))[^/\\\\:\\x00-\\x1f\\x7f<>\"|?*]*[^/\\\\:\\x00-\\x1f\\x7f<>\"|?* .])*(?![\\s\\S])"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "kind": {
              "enum": [
                "geometry",
                "rig",
                "animation",
                "scene",
                "material",
                "texture",
                "physics-world",
                "physics-cache"
              ]
            }
          },
          "required": [
            "id",
            "version",
            "path",
            "sha256",
            "kind"
          ]
        },
        "world_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "enum": [
                "blender",
                "pybullet"
              ]
            },
            "adapter_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
            },
            "solver_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "solver_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "application_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "platform": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "precision": {
              "enum": [
                "float32",
                "float64",
                "mixed"
              ]
            },
            "device": {
              "enum": [
                "cpu",
                "gpu"
              ]
            },
            "executable_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "id",
            "adapter_version",
            "solver_name",
            "solver_version",
            "application_version",
            "platform",
            "precision",
            "device",
            "executable_sha256"
          ]
        },
        "output_directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
