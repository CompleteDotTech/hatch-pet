        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "elapsed_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0
            },
            "peak_memory_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1125899906842624
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1125899906842624
            },
            "solver_steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          },
          "required": [
            "elapsed_seconds",
            "peak_memory_bytes",
            "output_bytes",
            "solver_steps"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "world",
        "world_sha256",
        "backend",
        "output_directory",
        "input_files",
        "frame_range",
        "fps",
        "fixed_step",
        "substeps",
        "budgets",
        "status",
        "attempt",
        "recovery",
        "checkpoint",
        "usage"
      ]
    }
  },
  "$ref": "#/$defs/PhysicsJob"
}
