        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bodies": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "dynamic_bodies": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "colliders": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "constraints": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "triangles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "vertices": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "cloth_vertices": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "soft_body_vertices": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "hair_strands": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "particles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "fluid_secondary_particles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "volume_cells": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "gas_cells": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "liquid_cells": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "output_frames": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "duration_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000000.0
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1125899906842624
            },
            "vram_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1125899906842624
            },
            "cache_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1125899906842624
            },
            "bake_file_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1125899906842624
            },
            "temporary_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1125899906842624
            },
            "cpu_workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "concurrent_jobs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "restart_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000000.0
            }
          },
          "required": [
            "bodies",
            "dynamic_bodies",
            "colliders",
            "constraints",
            "triangles",
            "vertices",
            "cloth_vertices",
            "soft_body_vertices",
            "hair_strands",
            "particles",
            "fluid_secondary_particles",
            "volume_cells",
            "gas_cells",
            "liquid_cells",
            "output_frames",
            "steps",
            "duration_seconds",
            "memory_bytes",
            "vram_bytes",
            "cache_bytes",
            "bake_file_bytes",
            "temporary_bytes",
            "cpu_workers",
            "concurrent_jobs",
            "restart_attempts",
            "timeout_seconds"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "recovery": {
          "enum": [
            "clean-restart",
            "verified-checkpoint"
          ]
        },
        "checkpoint": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?!(?:[cC][oO][nN](?:[iI][nN]\\$|[oO][uU][tT]\\$)?|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|/|(?![\\s\\S])))[^/\\\\:\\x00-\\x1f\\x7f<>\"|?*]*[^/\\\\:\\x00-\\x1f\\x7f<>\"|?* .](?:/(?!(?:[cC][oO][nN](?:[iI][nN]\\$|[oO][uU][tT]\\$)?|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|/|(?![\\s\\S])))[^/\\\\:\\x00-\\x1f\\x7f<>\"|?*]*[^/\\\\:\\x00-\\x1f\\x7f<>\"|?* .])*(?![\\s\\S])"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1125899906842624
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes"
              ]
            },
            {
              "type": "null"
