{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hatch camera3d animation v1",
  "$defs": {
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "const": "camera3d-animation"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "fps": {
          "$ref": "#/$defs/rate"
        },
        "timeline": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/reference"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "animation_project_3d",
                        "animation_sequence_3d",
                        "animation_clip_3d"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/reference"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "camera3d-path"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "terminal_pose": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "time": {
                  "$ref": "#/$defs/time"
                },
                "translation": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "rotation": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "required": [
                "time",
                "translation",
                "rotation"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "duration_frames",
        "fps",
        "timeline",
        "path",
        "terminal_pose",
        "metadata"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "name",
        "description",
        "provenance"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "authored",
            "import",
            "derived",
            "procedural-fixture"
          ]
        },
        "fixture": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "origin",
        "fixture",
        "attribution",
        "license",
        "inputs"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/) )(?!.*[\\\\:\\x00-\\x1f*?\"<>|])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?!.*[. ](?:/|(?![\\s\\S])))(?!(?:[^/]+/)*(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][nN][iI][nN]\\$|[cC][oO][nN][oO][uU][tT]\\$|[cC][oO][mM][1-9\u00b9\u00b2\u00b3]|[lL][pP][tT][1-9\u00b9\u00b2\u00b3])(?:[.]|/|(?![\\s\\S])))[^/]+(?:/[^/]+)*(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "kind"
      ]
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "subframe_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        }
      },
      "required": [
        "frame",
        "subframe_ticks"
      ]
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    }
  },
  "$ref": "#/$defs/animation"
}
