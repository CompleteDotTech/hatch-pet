{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetAnnotations v1",
  "$defs": {
    "AssetAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "maxLength": 32
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "favorite": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "schema_version",
        "asset",
        "revision",
        "tags",
        "favorite",
        "note"
      ]
    }
  },
  "$ref": "#/$defs/AssetAnnotations"
}
