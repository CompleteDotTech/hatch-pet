{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hatch-pet animation profile v1",
  "description": "Structural schema. profile_spec.validate_profile also checks relationship constraints, resource bounds and acyclic derivations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "layout",
    "states"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "cell_width",
        "cell_height"
      ],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "cell_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "cell_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "frames",
          "durations",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "not": {
              "enum": [
                "aux",
                "base",
                "com1",
                "com2",
                "com3",
                "com4",
                "com5",
                "com6",
                "com7",
                "com8",
                "com9",
                "con",
                "lpt1",
                "lpt2",
                "lpt3",
                "lpt4",
                "lpt5",
                "lpt6",
                "lpt7",
                "lpt8",
                "lpt9",
                "nul",
                "prn"
              ]
            }
          },
          "frames": {
            "type": "integer",
            "minimum": 1
          },
          "durations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 10,
              "maximum": 60000
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "motion": {
            "enum": [
              "quiet",
              "vertical",
              "directional",
              "gesture",
              "static"
            ]
          },
          "alignment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "coordinate_policy": {
                "enum": [
                  "slot",
                  "center",
                  "baseline"
                ]
              },
              "scale_policy": {
                "enum": [
                  "row",
                  "shared",
                  "none"
                ]
              },
              "padding": {
                "type": "integer",
                "minimum": 0
              },
              "anchor": {
                "$ref": "#/$defs/point"
              },
              "pivot": {
                "$ref": "#/$defs/point"
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "scale"
                  ]
                },
                "then": {
                  "properties": {
                    "scale_policy": {
                      "const": "shared"
                    }
                  },
                  "required": [
                    "scale_policy"
                  ]
                }
              }
            ]
          },
          "generation": {
            "$ref": "#/$defs/generation"
          },
          "allowed_derivations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source",
                "requires_explicit_approval"
              ],
              "properties": {
                "kind": {
                  "const": "horizontal-mirror"
                },
                "source": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "requires_explicit_approval": {
                  "const": true
                }
              }
            },
            "maxItems": 1
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min_motion": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "max_size_ratio": {
                "type": "number",
                "minimum": 1
              },
              "max_baseline_shift": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "loop_warning_ratio": {
                "type": "number",
                "minimum": 1
              },
              "near_duplicate_delta": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "palette_distance_warning": {
                "type": "number",
                "minimum": 0
              },
              "min_used_pixels": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_provenance": {
          "type": "boolean",
          "const": true
        },
        "allow_detached_details": {
          "type": "boolean"
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats",
        "static_state"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "frames",
              "atlas",
              "gif",
              "webp",
              "browser"
            ]
          }
        },
        "static_state": {
          "type": "string"
        },
        "static_frame": {
          "type": "integer",
          "minimum": 0
        },
        "codex_compatible": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill": {
          "const": "imagegen"
        },
        "requires_identity_reference": {
          "const": true
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
