{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetPreview v1",
  "$defs": {
    "AssetPreview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "thumbnail",
            "turntable",
            "motion",
            "material"
          ]
        },
        "source_version_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "backend_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "settings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "camera_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lighting_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file": {
          "$ref": "#/$defs/AssetFile"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "status": {
          "enum": [
            "generated",
            "verified-externally"
          ]
        }
      },
      "required": [
        "type",
        "source_version_sha256",
        "backend",
        "backend_version",
        "settings_sha256",
        "camera_sha256",
        "lighting_sha256",
        "file",
        "width",
        "height",
        "status"
      ]
    },
    "AssetFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "format": {
          "enum": [
            "glb",
            "gltf",
            "obj",
            "png",
            "jpeg",
            "webp",
            "json",
            "binary"
          ]
        },
        "mime_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "role",
        "sha256",
        "bytes",
        "format",
        "mime_type",
        "required"
      ]
    }
  },
  "$ref": "#/$defs/AssetPreview"
}
