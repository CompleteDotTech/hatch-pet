{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetDependency v1",
  "$defs": {
    "AssetDependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])",
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])",
              "maxLength": 32
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "required": {
          "type": "boolean"
        },
        "origin": {
          "enum": [
            "authored",
            "imported",
            "discovered"
          ]
        },
        "relationship": {
          "enum": [
            "direct",
            "transitive"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "target",
        "purpose",
        "required",
        "origin",
        "relationship",
        "capabilities"
      ]
    }
  },
  "$ref": "#/$defs/AssetDependency"
}
