{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hatch asset input interfaces v1",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "markings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approved_props": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "asymmetries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbid_mirror": {
          "type": "boolean"
        },
        "proportions": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "palette": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "directions": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "left",
              "right",
              "front",
              "back",
              "any"
            ]
          }
        }
      },
      "required": [
        "schema_version"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "import"
        },
        "layout": {
          "enum": [
            "image",
            "strip",
            "frames"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "layout",
        "files",
        "origin"
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rect": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "allow_components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "bounds": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "permit": {
                      "enum": [
                        "disconnected",
                        "bridge"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "bounds",
                    "permit",
                    "reason"
                  ]
                }
              }
            },
            "required": [
              "rect"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "source_sha256",
        "author",
        "note",
        "frames"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/identity"
    },
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/annotation"
    }
  ]
}
