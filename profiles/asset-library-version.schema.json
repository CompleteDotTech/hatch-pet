{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetVersion v1",
  "$defs": {
    "AssetVersion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "asset-library-version"
        },
        "identity": {
          "$ref": "#/$defs/AssetIdentity"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 32
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetFile"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetDependency"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": false
        },
        "metadata": {
          "$ref": "#/$defs/AssetMetadata"
        },
        "compatibility": {
          "$ref": "#/$defs/AssetCompatibility"
        },
        "previews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetPreview"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": false
        },
        "provenance": {
          "$ref": "#/$defs/AssetProvenance"
        },
        "publication": {
          "$ref": "#/$defs/AssetPublication"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "identity",
        "version",
        "files",
        "dependencies",
        "metadata",
        "compatibility",
        "previews",
        "provenance",
        "publication",
        "manifest_sha256"
      ]
    },
    "AssetPublication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visibility": {
          "enum": [
            "private",
            "project-local"
          ]
        },
        "distribution": {
          "enum": [
            "not-evaluated",
            "restricted"
          ]
        },
        "license_evaluation": {
          "enum": [
            "not-evaluated",
            "evidence-retained"
          ]
        },
        "inventory": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "verification": {
          "enum": [
            "payload-verified"
          ]
        },
        "integration": {
          "enum": [
            "not-exercised",
            "native-reference"
          ]
        }
      },
      "required": [
        "visibility",
        "distribution",
        "license_evaluation",
        "inventory",
        "verification",
        "integration"
      ]
    },
    "AssetProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "import",
            "generated",
            "derived",
            "fixture"
          ]
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "fixture": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetFile"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": false
        },
        "provider": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "receipt": {
                "$ref": "#/$defs/AssetFile"
              }
            },
            "required": [
              "name",
              "receipt"
            ]
          },
          "minItems": 0,
          "maxItems": 1,
          "uniqueItems": false
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "name",
              "version"
            ]
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": false
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                "maxLength": 64
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                "maxLength": 32
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "sha256"
            ]
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": false
        },
        "edits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "license_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetFile"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": false
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetFile"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": false
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "method",
        "origin",
        "fixture",
        "sources",
        "provider",
        "tools",
        "parents",
        "edits",
        "license_evidence",
        "permissions",
        "uncertainty"
      ]
    },
    "AssetFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "format": {
          "enum": [
            "glb",
            "gltf",
            "obj",
            "png",
            "jpeg",
            "webp",
            "json",
            "binary"
          ]
        },
        "mime_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "role",
        "sha256",
        "bytes",
        "format",
        "mime_type",
        "required"
      ]
    },
    "AssetPreview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "thumbnail",
            "turntable",
            "motion",
            "material"
          ]
        },
        "source_version_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "backend_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "settings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "camera_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lighting_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file": {
          "$ref": "#/$defs/AssetFile"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "status": {
          "enum": [
            "generated",
            "verified-externally"
          ]
        }
      },
      "required": [
        "type",
        "source_version_sha256",
        "backend",
        "backend_version",
        "settings_sha256",
        "camera_sha256",
        "lighting_sha256",
        "file",
        "width",
        "height",
        "status"
      ]
    },
    "AssetCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "enum": [
            "right-handed-y-up-z-forward",
            "legacy-2d"
          ]
        },
        "unit_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "rig_signature": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minItems": 0,
          "maxItems": 1,
          "uniqueItems": false
        },
        "skeleton_signature": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minItems": 0,
          "maxItems": 1,
          "uniqueItems": false
        },
        "material_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "texture_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "animation_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "renderers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "consumer_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "coordinate_system",
        "unit_scale",
        "rig_signature",
        "skeleton_signature",
        "material_capabilities",
        "texture_channels",
        "animation_channels",
        "renderers",
        "formats",
        "extensions",
        "consumer_capabilities"
      ]
    },
    "AssetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "allowed_uses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "style_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                "maxLength": 64
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                "maxLength": 32
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "sha256"
            ]
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": false
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "reviewed-externally"
          ]
        }
      },
      "required": [
        "description",
        "category",
        "author",
        "publisher",
        "source_url",
        "license",
        "allowed_uses",
        "keywords",
        "style_refs",
        "capabilities",
        "review_status"
      ]
    },
    "AssetDependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "maxLength": 32
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "required": {
          "type": "boolean"
        },
        "origin": {
          "enum": [
            "authored",
            "imported",
            "discovered"
          ]
        },
        "relationship": {
          "enum": [
            "direct",
            "transitive"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "target",
        "purpose",
        "required",
        "origin",
        "relationship",
        "capabilities"
      ]
    },
    "AssetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "library": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "character",
            "rig",
            "animation",
            "prop",
            "material",
            "texture",
            "environment",
            "light",
            "camera",
            "prefab",
            "reference",
            "legacy-pet",
            "legacy-cast",
            "legacy-clip"
          ]
        },
        "subtype": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "namespace",
        "library",
        "slug",
        "name",
        "kind",
        "subtype",
        "created_at",
        "attribution",
        "owner"
      ]
    }
  },
  "$ref": "#/$defs/AssetVersion"
}
