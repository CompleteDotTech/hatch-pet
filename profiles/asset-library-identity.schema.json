{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetIdentity v1",
  "$defs": {
    "AssetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "library": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "character",
            "rig",
            "animation",
            "prop",
            "material",
            "texture",
            "environment",
            "light",
            "camera",
            "prefab",
            "reference",
            "legacy-pet",
            "legacy-cast",
            "legacy-clip"
          ]
        },
        "subtype": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "namespace",
        "library",
        "slug",
        "name",
        "kind",
        "subtype",
        "created_at",
        "attribution",
        "owner"
      ]
    }
  },
  "$ref": "#/$defs/AssetIdentity"
}
