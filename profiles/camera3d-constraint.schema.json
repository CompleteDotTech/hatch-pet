{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hatch camera3d constraint v1",
  "$defs": {
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "const": "camera3d-constraint"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "type": {
          "enum": [
            "look-at",
            "frame",
            "focus",
            "collision",
            "horizon"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/reference"
              },
              {
                "properties": {
                  "kind": {
                    "const": "camera3d-target"
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "maxItems": 128
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "enabled": {
          "type": "boolean"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "up": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000000.0,
            "maximum": 1000000000.0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "safe_rect": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "distance_range_m": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000.0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "collision_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0
        },
        "failure": {
          "enum": [
            "reject",
            "warn"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "type",
        "targets",
        "priority",
        "enabled",
        "weight",
        "up",
        "safe_rect",
        "distance_range_m",
        "collision_radius_m",
        "failure",
        "metadata"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "name",
        "description",
        "provenance"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "authored",
            "import",
            "derived",
            "procedural-fixture"
          ]
        },
        "fixture": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "origin",
        "fixture",
        "attribution",
        "license",
        "inputs"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/) )(?!.*[\\\\:\\x00-\\x1f*?\"<>|])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?!.*[. ](?:/|(?![\\s\\S])))(?!(?:[^/]+/)*(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][nN][iI][nN]\\$|[cC][oO][nN][oO][uU][tT]\\$|[cC][oO][mM][1-9\u00b9\u00b2\u00b3]|[lL][pP][tT][1-9\u00b9\u00b2\u00b3])(?:[.]|/|(?![\\s\\S])))[^/]+(?:/[^/]+)*(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "kind"
      ]
    }
  },
  "$ref": "#/$defs/constraint"
}
