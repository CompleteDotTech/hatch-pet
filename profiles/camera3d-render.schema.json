{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hatch camera3d render v1",
  "$defs": {
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "const": "camera3d-render"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "pixel_aspect": {
          "$ref": "#/$defs/rate"
        },
        "overscan": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        },
        "gate_fit": {
          "enum": [
            "crop",
            "expand"
          ]
        },
        "output": {
          "enum": [
            "png",
            "exr"
          ]
        },
        "color_space": {
          "enum": [
            "linear-srgb",
            "srgb"
          ]
        },
        "transparent": {
          "type": "boolean"
        },
        "max_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "width",
        "height",
        "pixel_aspect",
        "overscan",
        "gate_fit",
        "output",
        "color_space",
        "transparent",
        "max_pixels"
      ]
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    }
  },
  "$ref": "#/$defs/render"
}
